APP_ENV=production
GIN_MODE=release
PORT=8080
TZ=Asia/Shanghai

DATABASE_URL=peopleops_user:<replace_with_strong_random_password>@tcp(mysql-host:3306)/peopleops?charset=utf8mb4&parseTime=True&loc=Local
REDIS_URL=redis-host:6379
REDIS_PASSWORD=

JWT_SECRET=<replace_with_openssl_rand_base64_48>

DINGTALK_APP_KEY=your_dingtalk_app_key
DINGTALK_APP_SECRET=your_dingtalk_app_secret
DINGTALK_STREAM_ORG_ID=
DINGTALK_CORP_ID=your_dingtalk_corp_id
DINGTALK_AGENT_ID=your_dingtalk_agent_id
DINGTALK_ADMIN_USER_ID=your_dingtalk_admin_user_id
DINGTALK_PROCESS_LEAVE=
DINGTALK_PROCESS_OVERTIME=
DINGTALK_PROCESS_ATTENDANCE_CORRECTION=
DINGTALK_PROCESS_POSITION_TRANSFER=

DINGTALK_APP_HOME_URL=https://hr.example.com/
DINGTALK_REDIRECT_URI=https://hr.example.com/callback
DINGTALK_QR_DEFAULT_ORG_ID=
APP_BASE_URL=https://hr.example.com
FRONTEND_BASE_URL=https://hr.example.com
CORS_ALLOW_ORIGINS=https://hr.example.com
# 以下三项必须保持 HTTPS：作息表群聊推送的临时图片由钉钉服务器回拉，
# 非 HTTPS 地址会被服务端拒绝并返回 503。

DINGTALK_LEAVE_SYNC_ENABLED=false
DINGTALK_COMP_TIME_SYNC_ENABLED=false
DINGTALK_LEAVE_HOURS_PER_DAY=8
DINGTALK_ANNUAL_LEAVE_CODE=
DINGTALK_ANNUAL_LEAVE_NAME=
DINGTALK_LIEU_LEAVE_CODE=
DINGTALK_LIEU_LEAVE_NAME=
DINGTALK_COMPENSATORY_LEAVE_CODE=
DINGTALK_COMPENSATORY_LEAVE_NAME=
ANNUAL_LEAVE_APPROVAL_KEYWORD=

DINGTALK_ATTENDANCE_GROUP_ID=
DINGTALK_ATTENDANCE_GROUP_NAME=
JUHE_API_KEY=
