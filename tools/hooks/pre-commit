#!/usr/bin/env bash
# 检测结构性新增、删除或重命名时，提醒更新按需 AI 项目文档。
# 根 AGENTS.md 只维护协作规则；业务结构变化优先更新 PROJECT_MAP 或对应 MODULES 文档。

STAGED_STATUS=$(git diff --cached --name-status)

STRUCTURAL_CHANGED=false
CHANGED_FILES=""

while IFS=$'\t' read -r status path renamed_path; do
  case "$status" in
    A|D|R*) ;;
    *) continue ;;
  esac

  file="$path"
  display="$path"
  if [[ "$status" == R* ]]; then
    file="$renamed_path"
    display="$path -> $renamed_path"
  fi

  case "$file" in
    internal/service/*.go|\
    internal/api/*.go|\
    internal/repository/*.go|\
    internal/database/*models.go|\
    frontend/src/pages/*.tsx|\
    frontend/src/services/*.ts)
      STRUCTURAL_CHANGED=true
      CHANGED_FILES="$CHANGED_FILES\n    $display"
      ;;
  esac
done <<< "$STAGED_STATUS"

if [ "$STRUCTURAL_CHANGED" = "true" ]; then
  if echo "$STAGED_STATUS" | grep -Eq $'^[A-Z][0-9]*\t\.ai/(PROJECT_MAP\.md|MODULES/)'; then
    echo "[hook] AI 项目索引或模块文档已同步更新 ✓"
  else
    echo ""
    echo "[hook] 检测到结构性新增、删除或重命名，但未更新 AI 项目索引/模块文档："
    echo -e "$CHANGED_FILES"
    echo ""
    echo "  如形成长期结构或模块知识，请 Ctrl+C 取消后更新 .ai/PROJECT_MAP.md 或 .ai/MODULES/<module>.md。"
    echo "  不要因普通业务变更更新 AGENTS.md 或 CLAUDE.md。"
    echo "  如无需更新，输入 y 直接提交："
    read -r answer < /dev/tty
    if [ "$answer" != "y" ] && [ "$answer" != "Y" ]; then
      echo "[hook] 已取消提交。"
      exit 1
    fi
  fi
fi

exit 0
